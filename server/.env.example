# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL. The database must exist; tables are created automatically on first start.
DATABASE_URL=postgres://postgres:@127.0.0.1:54321/camera_stream

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# First admin account (created automatically on first start if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# FFmpeg binary. Leave empty to use the bundled ffmpeg-static binary.
FFMPEG_PATH=
